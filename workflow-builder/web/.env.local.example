# Copy this file to .env.local (for local dev) and set the same keys in Vercel's
# project settings (for the deployed app). Get the exact URLs from your Nhost
# project dashboard -> Settings -> General. Do not guess the URL pattern.

NEXT_PUBLIC_NHOST_GRAPHQL_URL=https://your-subdomain.graphql.your-region.nhost.run/v1/graphql
NEXT_PUBLIC_NHOST_AUTH_URL=https://your-subdomain.auth.your-region.nhost.run/v1
